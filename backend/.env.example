# [un]scripted 2.0 backend configuration. Copy to backend/.env (git-ignored) and fill in.
# NEVER commit backend/.env. NEVER put the OpenAI key in firmware or the dashboard.

# ---- AI provider -------------------------------------------------------------
# openai = the real integration (required for any participant-facing use).
# mock   = canned test output for automated tests ONLY (labelled MOCK_PROVIDER everywhere).
# Paste your key after the = sign (no quotes). Leave empty until you have one.
UNSCRIPTED_AI_PROVIDER=openai
OPENAI_API_KEY=

# Pinned models (see docs/RESEARCH_REPRODUCIBILITY.md). Change only deliberately and record it.
STT_MODEL=gpt-transcribe
STT_LANGUAGE=en
LLM_MODEL=gpt-6-luna
LLM_REASONING_EFFORT=none
LLM_TEMPERATURE=0.3
LLM_MAX_OUTPUT_TOKENS=160
TTS_MODEL=gpt-4o-mini-tts-2025-12-15
TTS_VOICE=marin
TTS_SPEED=0.9

# ---- dashboard access codes (long random strings; generate with: openssl rand -base64 24) ----
RESEARCHER_TOKEN=REPLACE_ME
CAREGIVER_TOKEN=REPLACE_ME

# ---- optional ----------------------------------------------------------------
# DATA_DIR=./data
# SESSION_EXPIRY_S=600
# TURN_BUDGET_S=11
